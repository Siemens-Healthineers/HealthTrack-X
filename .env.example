# ── HealthTrack-X Environment Variables ──────────────────────
# Environment template for docker-compose and ad-hoc local backend runs.
# The canonical local demonstrator uses Rancher Desktop/K3s plus
# k8s/overlays/local or k8s/overlays/local-ollama, so most developers do not
# need a .env file unless they use the supplementary docker-compose stack.
# ──────────────────────────────────────────────────────────────

# ============================================
# Authentication (Keycloak)
# ============================================
AUTH_ENABLED=false
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Frontend OIDC (build-time)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/healthtrack-x
VITE_OIDC_CLIENT_ID=healthtrackx-frontend

# Backend OIDC (runtime)
KEYCLOAK_ISSUER=http://localhost:8080/realms/healthtrack-x
KEYCLOAK_JWKS_URL=http://htx-keycloak:8080/realms/healthtrack-x/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=healthtrackx-frontend

# ============================================
# GitHub (App-based Auth)
# ============================================
GITHUB_BASE_URL=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO=owner/repo-name
GITHUB_BRANCH=main

# ============================================
# GitHub OAuth (optional login via GitHub)
# ============================================
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# JWT_SECRET=change-me-to-a-random-secret
# FRONTEND_URL=http://localhost:5173
# ADMIN_USERS=

# ============================================
# EDC Tractus-X Connector (optional)
# ============================================
# EDC_MANAGEMENT_URL=http://localhost:19193/management
# EDC_PROTOCOL_URL=http://localhost:19194/protocol
# EDC_API_KEY=your-api-key
# EDC_PARTICIPANT_ID=BPNL00000003XXXX

# ============================================
# HashiCorp Vault (optional)
# ============================================
# VAULT_URL=http://localhost:8200
# VAULT_TOKEN=htx-dev-token
# VAULT_MOUNT_POINT=secret
# VAULT_BASE_PATH=healthtrack-x

# ============================================
# Auth profiles (copy the block you need over the values above)
# ============================================
# Note: Kubernetes deployments do NOT use this file — they read configuration
# from the ConfigMap and Secret in k8s/. These profiles are only for the
# docker-compose / ad-hoc local backend path.
#
# --- Local demonstrator with Keycloak enabled (localhost) ---
# AUTH_ENABLED=true
# KEYCLOAK_ISSUER=http://localhost:8080/realms/healthtrack-x
# KEYCLOAK_CLIENT_ID=healthtrackx-frontend
# KEYCLOAK_AUDIENCE=healthtrackx-backend
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/healthtrack-x/protocol/openid-connect/certs
# AUTH_PUBLIC_PATHS=/,/api/auth/status,/api/system-status,/docs*,/openapi.json,/redoc*
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
#
# --- Production / Azure (use real domains; keep docs private at the edge) ---
# AUTH_ENABLED=true
# KEYCLOAK_ISSUER=https://<auth-domain>/realms/healthtrack-x
# KEYCLOAK_CLIENT_ID=healthtrackx-frontend
# KEYCLOAK_AUDIENCE=healthtrackx-backend
# KEYCLOAK_JWKS_URL=https://<auth-domain>/realms/healthtrack-x/protocol/openid-connect/certs
# CORS_ORIGINS=https://<frontend-domain>
# AUTH_PUBLIC_PATHS=/api/auth/status,/api/system-status
